{
  "name": "heads-commit-reveal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/licenses.mjs && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:export": "node scripts/export.mjs --check",
    "test": "node scripts/browser-test.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
